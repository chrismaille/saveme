[Unit]
Description=SaveMe sync and backup daemon
Documentation=https://github.com/chrismaille/saveme
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=io.github.chrismaille.SaveMe.Daemon
ExecStart=/usr/bin/saveme-daemon
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
